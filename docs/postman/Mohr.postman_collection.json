{
  "info": {
    "_postman_id": "mohr-api-v1",
    "name": "مُهر (Mohr) API v1",
    "description": "REST API مُهر — پس از `php artisan db:seed` از بالا به پایین اجرا کنید.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"کاربر Postman\",\n  \"email\": \"postman-{{$randomInt}}@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/register",
            "description": "ثبت‌نام کاربر جدید با کیف پول خالی؛ توکن Bearer برمی‌گردد."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); pm.environment.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
            {
              "name": "Success",
              "originalRequest": { "method": "POST", "url": "{{base_url}}/auth/register" },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"user\": { \"id\": 1, \"name\": \"کاربر\", \"email\": \"user@example.com\", \"role\": \"user\", \"role_label\": \"کاربر عادی\" },\n  \"token\": \"1|example\",\n  \"token_type\": \"Bearer\",\n  \"expires_at\": null\n}"
            },
            {
              "name": "Validation 422",
              "originalRequest": { "method": "POST", "url": "{{base_url}}/auth/register" },
              "status": "Unprocessable Entity",
              "code": 422,
              "body": "{\n  \"message\": \"داده‌های ارسالی نامعتبر است.\",\n  \"code\": \"validation_error\",\n  \"errors\": { \"email\": [\"این ایمیل قبلاً ثبت شده است.\"] }\n}"
            }
          ]
        },
        {
          "name": "Login (user)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login",
            "description": "ورود کاربر seed شده (`user@example.com` / `password`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.token).to.be.a('string');",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.environment.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
            {
              "name": "Success",
              "code": 200,
              "body": "{\n  \"user\": { \"email\": \"user@example.com\" },\n  \"token\": \"2|secret\",\n  \"token_type\": \"Bearer\"\n}"
            },
            {
              "name": "Wrong credentials 422",
              "code": 422,
              "body": "{\n  \"message\": \"اطلاعات ورود نادرست است.\",\n  \"code\": \"validation_error\",\n  \"errors\": { \"email\": [\"اطلاعات ورود نادرست است.\"] }\n}"
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman-admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('admin_token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/auth/me",
            "description": "کاربر فعلی + موجودی کیف پول."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().wallet).to.have.property('balance');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Get wallet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/wallet"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().cost_per_request).to.eql(1000);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Top up (simulated)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/wallet/top-up",
            "description": "شارژ شبیه‌سازی‌شده برای تست (بدون درگاه)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/wallet/transactions?per_page=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Contents",
      "item": [
        {
          "name": "Create content",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"متن نمونه برای moderation از Postman — حداقل پنج کاراکتر.\",\n  \"channel\": \"web\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/contents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const id = pm.response.json().data.id;",
                  "pm.environment.set('content_id', id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
            {
              "name": "Success 201",
              "code": 201,
              "body": "{\n  \"data\": { \"id\": 1, \"status\": \"pending\", \"status_label\": \"در انتظار بررسی\" }\n}"
            },
            {
              "name": "Insufficient balance 402",
              "code": 402,
              "body": "{\n  \"message\": \"موجودی کیف پول کافی نیست\",\n  \"code\": \"insufficient_balance\"\n}"
            },
            {
              "name": "Validation 422",
              "code": 422,
              "body": "{\n  \"message\": \"داده‌های ارسالی نامعتبر است.\",\n  \"code\": \"validation_error\",\n  \"errors\": { \"body\": [\"متن باید حداقل ۵ کاراکتر باشد.\"] }\n}"
            }
          ]
        },
        {
          "name": "List contents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/contents?per_page=10&channel=web"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Show content",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/contents/{{content_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
            {
              "name": "Forbidden 403",
              "code": 403,
              "body": "{\n  \"message\": \"دسترسی غیرمجاز.\",\n  \"code\": \"forbidden\"\n}"
            }
          ]
        },
        {
          "name": "Content logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/contents/{{content_id}}/logs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Retry moderation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/contents/{{content_id}}/retry",
            "description": "فقط برای محتوای `failed` با retry_count < 3."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202 or 409', () => pm.expect([202,409]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
            {
              "name": "Not retryable 409",
              "code": 409,
              "body": "{\n  \"message\": \"انتقال وضعیت مجاز نیست.\",\n  \"code\": \"not_retryable\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
      },
      "item": [
        {
          "name": "List contents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/admin/contents?status=pending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/admin/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const first = pm.response.json().data && pm.response.json().data[0];",
                  "if (first) { pm.environment.set('user_id', first.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Top up user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/users/{{user_id}}/top-up"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List blacklist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/admin/blacklist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add blacklist word",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"word\": \"کلمه‌آزمایشی-{{$randomInt}}\",\n  \"severity\": \"block\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/admin/blacklist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const id = pm.response.json().data.id;",
                  "pm.environment.set('word_id', id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete blacklist word",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/admin/blacklist/{{word_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
